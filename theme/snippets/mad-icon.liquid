{% doc %}
  Renders an inline SVG icon used by the MAD sections.

  @param {string} name - minus, plus, chevron-left, chevron-right, star, star-outline, email, facebook, instagram, search

  @example
  {% render 'mad-icon', name: 'plus' %}
{% enddoc %}
{%- case name -%}
  {%- when 'minus' -%}
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M1 8h14" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
  {%- when 'plus' -%}
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M1 8h14M8 1v14" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
  {%- when 'chevron-left' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15.5 3.5 7 12l8.5 8.5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
  {%- when 'chevron-right' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8.5 3.5 17 12l-8.5 8.5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m12 2.5 2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" fill="currentColor"/></svg>
  {%- when 'star-outline' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m12 2.5 2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
  {%- when 'email' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h18v12H3z" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="m3 6 9 7 9-7" fill="none" stroke="currentColor" stroke-width="2.4"/></svg>
  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13.4 22v-8.4h2.8l.4-3.3h-3.2V8.2c0-.9.3-1.6 1.6-1.6h1.7V3.7c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.2v3.3H10V22z" fill="currentColor"/></svg>
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.4" cy="6.6" r="1.2" fill="currentColor"/></svg>
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m15.5 15.5 5 5" fill="none" stroke="currentColor" stroke-width="2"/></svg>
{%- endcase -%}
