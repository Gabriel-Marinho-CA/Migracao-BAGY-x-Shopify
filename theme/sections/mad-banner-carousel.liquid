{%- liquid
  assign slide_count = section.blocks.size
  assign delay = section.settings.speed | times: 1000
-%}
{%- capture swiper_config -%}
  {"slidesPerView":1,"speed":600,"loop":{% if slide_count > 1 %}true{% else %}false{% endif %}{% if section.settings.autoplay and slide_count > 1 %},"autoplay":{"delay":{{ delay }},"pauseOnMouseEnter":true,"disableOnInteraction":false}{% endif %}}
{%- endcapture -%}
<div class="mad-banners mad-carousel" data-mad-swiper="{{ swiper_config | strip | escape }}">
  <div class="swiper">
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        {%- liquid
          assign loading = 'lazy'
          if forloop.first and section.index < 3
            assign loading = 'eager'
          endif
          assign alt = block.settings.alt | default: block.settings.image.alt | default: shop.name
        -%}
        <div class="swiper-slide" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="mad-banners__link">
          {%- endif -%}
          <picture>
            {%- if block.settings.image_mobile != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ block.settings.image_mobile | image_url: width: 600 }} 600w, {{ block.settings.image_mobile | image_url: width: 900 }} 900w, {{ block.settings.image_mobile | image_url: width: 1200 }} 1200w"
                sizes="100vw"
              >
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1920
                | image_tag:
                  class: 'mad-banners__image',
                  widths: '750, 1100, 1440, 1920',
                  sizes: '100vw',
                  loading: loading,
                  alt: alt
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'mad-banners__image placeholder-svg' }}
            {%- endif -%}
          </picture>
          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.settings.show_arrows and slide_count > 1 -%}
    <button type="button" class="mad-carousel__arrow mad-carousel__arrow--prev" data-mad-prev aria-label="Banner anterior">
      {%- render 'mad-icon', name: 'chevron-left' -%}
    </button>
    <button type="button" class="mad-carousel__arrow mad-carousel__arrow--next" data-mad-next aria-label="Próximo banner">
      {%- render 'mad-icon', name: 'chevron-right' -%}
    </button>
  {%- endif -%}
  {%- if section.settings.show_dots and slide_count > 1 -%}
    <div class="mad-carousel__dots" data-mad-dots></div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "MAD - Banners",
  "tag": "section",
  "class": "section mad-section",
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Troca automática", "default": true },
    { "type": "range", "id": "speed", "label": "Tempo por banner", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "checkbox", "id": "show_arrows", "label": "Mostrar setas", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Mostrar marcadores", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem desktop (1920x500)" },
        { "type": "image_picker", "id": "image_mobile", "label": "Imagem mobile (600x700)" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "alt", "label": "Texto alternativo" }
      ]
    }
  ],
  "presets": [
    { "name": "MAD - Banners", "blocks": [{ "type": "slide" }, { "type": "slide" }] }
  ]
}
{% endschema %}
