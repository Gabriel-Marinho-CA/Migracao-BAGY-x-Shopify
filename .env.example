# Copie para .env e preencha. O .env nao deve ser versionado.

# ---------------------------------------------------------------------------
# Shopify
# ---------------------------------------------------------------------------
# Dominio da loja (aceita com ou sem https://).
SHOPIFY_STORE_DOMAIN=turbo-starter.myshopify.com

# Admin API access token. O shpua_... do api-keys funciona (testado).
# Um shpat_... de custom app tambem serve.
# ATENCAO: a "chave secreta" shpss_... NAO serve aqui - e o client secret do
# app, usado so no fluxo OAuth e no HMAC de webhook.
SHOPIFY_ADMIN_TOKEN=

SHOPIFY_API_VERSION=2026-07
SHOPIFY_CURRENCY=BRL

# Lojas de desenvolvimento/trial aceitam no maximo 5 orderCreate por minuto.
# Em loja paga da para subir esse numero.
SHOPIFY_ORDERS_PER_MINUTE=5
SHOPIFY_MAX_RETRIES=5

# ---------------------------------------------------------------------------
# Bagy
# ---------------------------------------------------------------------------
BAGY_MOCK_DIR=mocks
# O Brasil nao tem horario de verao desde 2019, entao o offset e fixo.
BAGY_TIMEZONE_OFFSET=-03:00

# API real da loja. ATENCAO: nao e a API de developers.bagy.com.br (aquela e a
# plataforma antiga, formato Tray/CommerceSuite). A desta loja e api.dooca.store,
# autenticada com o token JWT da Bagy via "Authorization: Bearer".
BAGY_API_BASE=https://api.dooca.store
BAGY_API_TOKEN=
# O limite de requisicoes nao e publico (vem num checklist de parceiro).
# 60/min e conservador; ha backoff automatico em 429.
BAGY_REQUESTS_PER_MINUTE=60
BAGY_MAX_RETRIES=5
# 150 e o maximo aceito pela maioria dos recursos.
BAGY_PAGE_SIZE=150

# ---------------------------------------------------------------------------
# Extracao (run_extraction.py)
# ---------------------------------------------------------------------------
# CONTEM DADOS PESSOAIS (CPF, e-mail, endereco). data/ esta no .gitignore.
EXTRACT_DB=data/bagy.sqlite
EXTRACT_EXPORT_DIR=data/export
EXTRACT_ASSETS_DIR=data/assets
# Hosts da Bagy cujas imagens sao baixadas (morrem quando a loja for desligada).
EXTRACT_ASSET_HOSTS=cdn.dooca.store,api4.dooca.store

# ---------------------------------------------------------------------------
# Transformacao (run_transform.py)
# ---------------------------------------------------------------------------
TRANSFORM_DB=data/shopify.sqlite
TRANSFORM_OUT_DIR=data/shopify
# Pedidos com NF-e emitida mas sem envio registrado na Bagy: acima de N dias sao
# migrados como enviados (sem rastreio), para nao encher a fila de expedicao.
TRANSFORM_FULFILL_INVOICED_AFTER_DAYS=30
# Numero do pedido na Shopify = codigo do pedido na Bagy.
TRANSFORM_ORDER_NAME_FROM_CODE=1
# Inscritos na newsletter que nunca compraram viram clientes com aceite de marketing.
TRANSFORM_INCLUDE_LEADS=1
# Descontos inativos ou vencidos na Bagy (padrao: nao migrar).
TRANSFORM_INCLUDE_INACTIVE_DISCOUNTS=0
TRANSFORM_BLOG_TITLE=Blog
TRANSFORM_BLOG_HANDLE=blog
TRANSFORM_ARTICLE_AUTHOR=Mad 4 Life

# ---------------------------------------------------------------------------
# Arquivos de trabalho
# ---------------------------------------------------------------------------
MIGRATION_STATE_FILE=state/migrated.json
MIGRATION_PAYLOAD_DIR=out/payloads

# Log de erros da API: errors.jsonl (estruturado) + errors.log (legivel).
MIGRATION_LOG_DIR=logs
# Grava junto o payload que falhou, para reprocessar depois. 0 para desligar.
MIGRATION_LOG_PAYLOADS=1
