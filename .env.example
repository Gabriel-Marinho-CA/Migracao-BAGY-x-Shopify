# Copie para .env e preencha. O .env nao deve ser versionado.

# ---------------------------------------------------------------------------
# Shopify
# ---------------------------------------------------------------------------
# Dominio da loja (aceita com ou sem https://).
SHOPIFY_STORE_DOMAIN=turbo-starter.myshopify.com

# Admin API access token. O shpua_... do api-keys funciona (testado).
# Um shpat_... de custom app tambem serve.
# ATENCAO: a "chave secreta" shpss_... NAO serve aqui - e o client secret do
# app, usado so no fluxo OAuth e no HMAC de webhook.
SHOPIFY_ADMIN_TOKEN=

SHOPIFY_API_VERSION=2026-07
SHOPIFY_CURRENCY=BRL

# Lojas de desenvolvimento/trial aceitam no maximo 5 orderCreate por minuto.
# Em loja paga da para subir esse numero.
SHOPIFY_ORDERS_PER_MINUTE=5
SHOPIFY_MAX_RETRIES=5

# ---------------------------------------------------------------------------
# Bagy
# ---------------------------------------------------------------------------
BAGY_MOCK_DIR=mocks
# O Brasil nao tem horario de verao desde 2019, entao o offset e fixo.
BAGY_TIMEZONE_OFFSET=-03:00

# Preencher quando as credenciais da API real forem liberadas
# (hoje o script le de ./mocks).
BAGY_API_BASE_URL=
BAGY_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Arquivos de trabalho
# ---------------------------------------------------------------------------
MIGRATION_STATE_FILE=state/migrated.json
MIGRATION_PAYLOAD_DIR=out/payloads

# Log de erros da API: errors.jsonl (estruturado) + errors.log (legivel).
MIGRATION_LOG_DIR=logs
# Grava junto o payload que falhou, para reprocessar depois. 0 para desligar.
MIGRATION_LOG_PAYLOADS=1
